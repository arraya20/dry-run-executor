{
  "name": "dry-run-executor",
  "version": "2.0.0",
  "description": "Simulate a Pharos transaction against real state \u2014 cost, revert reason, and funding \u2014 before it is signed. Measures by bisection instead of trusting the node's estimate.",
  "type": "module",
  "bin": {
    "dry-run": "./bin/dry-run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/unit.test.mjs && node test/api.test.mjs",
    "test:unit": "node test/unit.test.mjs",
    "test:api": "node test/api.test.mjs",
    "test:live": "node test/live.test.mjs",
    "verify:chain": "node scripts/verify-chain.mjs"
  },
  "keywords": [
    "pharos",
    "evm",
    "simulation",
    "preflight",
    "dry-run"
  ],
  "license": "MIT",
  "files": [
    "src",
    "bin",
    "scripts",
    "functions",
    "public",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "author": "arraya20",
  "publishConfig": {
    "access": "public"
  }
}
